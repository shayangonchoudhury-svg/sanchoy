rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User Profile document
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt'])
        && data.uid == userId
        && data.uid is string && data.uid.size() <= 128
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for Encrypted Workspace document (Contains zero plaintext financial data)
    function isValidEncryptedWorkspace(data) {
      return data.keys().hasAll(['cryptoVersion', 'passcodeWrappedKey', 'encryptedData'])
        && data.keys().hasOnly([
          'cryptoVersion', 'schemaVersion',
          'passcodeWrappedKey', 'passcodeSalt', 'passcodeWrapIv',
          'recoveryWrappedKey', 'recoverySalt', 'recoveryWrapIv',
          'encryptedData', 'encryptedDataIv',
          'clientRevision', 'createdAt', 'updatedAt'
        ])
        && data.cryptoVersion is number
        && data.passcodeWrappedKey is string && data.passcodeWrappedKey.size() <= 2048
        && data.encryptedData is string && data.encryptedData.size() <= 1048576
        && (!('passcodeSalt' in data) || (data.passcodeSalt is string && data.passcodeSalt.size() <= 256))
        && (!('passcodeWrapIv' in data) || (data.passcodeWrapIv is string && data.passcodeWrapIv.size() <= 256))
        && (!('recoveryWrappedKey' in data) || (data.recoveryWrappedKey is string && data.recoveryWrappedKey.size() <= 2048))
        && (!('recoverySalt' in data) || (data.recoverySalt is string && data.recoverySalt.size() <= 256))
        && (!('recoveryWrapIv' in data) || (data.recoveryWrapIv is string && data.recoveryWrapIv.size() <= 256))
        && (!('encryptedDataIv' in data) || (data.encryptedDataIv is string && data.encryptedDataIv.size() <= 256))
        && (!('clientRevision' in data) || data.clientRevision is number)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User profile endpoint
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket enumeration strictly forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Private encrypted workspace subcollection
    match /users/{userId}/private/{workspaceId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(workspaceId);
      allow list: if false; // Blanket enumeration strictly forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(workspaceId) && isValidEncryptedWorkspace(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidId(workspaceId) && isValidEncryptedWorkspace(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(workspaceId);
    }
  }
}
